# =============================================================================
# paperless-qdrant-ingestion - environment.
#
# These values normally live in the shared platform .env of the
# homeagents-core repository; the compose file is started with
# `--env-file ../homeagents-core/.env`. Use this file when you run the worker
# on its own.
#
# `data/` and `.env` are git-ignored. Never commit real tokens.
# =============================================================================

# --- Required ---
PAPERLESS_URL=https://paperless.example.com/
PAPERLESS_API_TOKEN=

# --- Shared services (defaults match the compose file) ---
QDRANT_URL=http://qdrant:6333
TEI_URL=http://embeddings:80
COLLECTION_NAME=memory
EMBEDDINGS_MODEL=BAAI/bge-m3

# --- Worker behaviour ---
STATE_FILE=/app/data/ingestion-state.json
INGESTION_MAP_FILE=/app/config/ingestion-map.yaml
LOG_LEVEL=INFO
